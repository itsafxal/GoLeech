# ==============================================================================
# GoLeech Environment Configuration
# Tagline: Mirror Anything. Leech Anywhere. Powered by Go.
# ==============================================================================

# -----------------
# Telegram MTProto (Required)
# -----------------
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_API=1234567
TELEGRAM_HASH=abcdef0123456789abcdef0123456789
OWNER_ID=123456789

# -----------------
# User Session (Optional for 4GB Telegram Premium Uploads)
# Generate safely using: go run ./cmd/login
# -----------------
USER_SESSION_STRING=

# -----------------
# Access Control & Security
# -----------------
SUDO_USERS=123456789 987654321
AUTHORIZED_CHATS=-100123456789 -100987654321
CMD_SUFFIX=

# -----------------
# Task & Concurrency Control
# -----------------
STATUS_LIMIT=10
STATUS_UPDATE_INTERVAL=10
QUEUE_ALL=10
QUEUE_DOWNLOAD=5
QUEUE_UPLOAD=5
TORRENT_LIMIT=0
DIRECT_LIMIT=0
STORAGE_LIMIT=0

# -----------------
# Web Dashboard & Streaming Server
# -----------------
WEB_PORT=8080
WEB_ACCESS_PASSWORD=ChangeThisSecretPassword123

# -----------------
# Default Storage & Upload Destinations
# Choices: tg (Telegram), rc (Rclone), pixeldrain, gofile
# -----------------
DEFAULT_UPLOAD=tg
LEECH_SPLIT_SIZE=2097152000
LEECH_LOG_CHAT=0
LEECH_PREFIX=
LEECH_SUFFIX=
LEECH_CAPTION=

# -----------------
# Cloud Storage (Rclone)
# -----------------
RCLONE_PATH=remote:backup
RCLONE_FLAGS=--transfers=4 --checkers=8
RCLONE_SERVE_URL=

# -----------------
# RSS Automation
# -----------------
RSS_DELAY=600

# -----------------
# Feature Toggles
# -----------------
DISABLE_LEECH=false
DISABLE_MIRROR=false
DISABLE_TORRENTS=false
DISABLE_RSS=false
DISABLE_SEARCH=false

