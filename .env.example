# ==============================================================================
# GoLeech — Master Environment Configuration
# Tagline: Mirror Anything. Leech Anywhere. Powered by Go & MTProto.
# ==============================================================================

# ==============================================================================
# 1. ESSENTIAL BOT CONFIGURATION (Mandatory)
# ==============================================================================
# Telegram Bot API token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Application API ID obtained from https://my.telegram.org (alias: TELEGRAM_API)
API_ID=1234567

# Telegram Application API Hash obtained from https://my.telegram.org (alias: TELEGRAM_HASH)
API_HASH=0123456789abcdef0123456789abcdef

# Telegram User ID of the primary administrator / bot owner (Required for Admin rights)
OWNER_ID=123456789

# MongoDB Connection URI (Authoritative permanent storage, e.g. mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority)
# Aliases: DATABASE_URL, MONGODB_URI. If empty, bot falls back to local SQLite WAL mode.
MONGO_URI=

# ==============================================================================
# 2. CORE APPLICATION SETTINGS
# ==========================================
# Public display name of the bot
BOT_NAME=GoLeech

# Space- or comma-separated Telegram User IDs granted Sudo operator privileges
SUDO_USERS=

# Space- or comma-separated Telegram Group / Channel IDs permitted for usage
AUTHORIZED_CHATS=

# Optional custom command suffix (e.g. "_bot" enables /leech_bot, /mirror_bot)
CMD_SUFFIX=

# Application timezone for timestamps and logging
TIMEZONE=UTC

# System logging verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ==============================================================================
# 3. DATABASE CONFIGURATION
# ==============================================================================
# MongoDB target database name (Default: goleech)
DATABASE_NAME=goleech

# SQLite local database file path (Fallback when MONGO_URI is omitted)
DATABASE_PATH=goleech.db

# MongoDB maximum connection pool size
DB_MAX_POOL_SIZE=50

# MongoDB minimum connection pool size
DB_MIN_POOL_SIZE=5

# Database network connection timeout in seconds
DB_TIMEOUT=10

# ==============================================================================
# 4. TELEGRAM / MTPROTO SETTINGS
# ==============================================================================
# String session for optional 4GB Telegram Premium uploads/downloads (alias: USER_SESSION_STRING)
# Generate securely via: go run ./cmd/login
SESSION_STRING=

# Default send mode for leeched media files: true = Send as Document, false = Send as Media
LEECH_AS_DOCUMENT=true

# Split size limit in bytes for Telegram uploads (Default: 2097152000 = ~2GB; Premium supports up to 4GB)
LEECH_SPLIT_SIZE=2097152000

# Telegram chat or channel ID where leech upload copies are archived (Optional)
LEECH_LOG_CHAT=0

# Default filename prefix applied to all leeched uploads (Optional)
LEECH_PREFIX=

# Default filename suffix applied to all leeched uploads (Optional)
LEECH_SUFFIX=

# Default caption template for leeched uploads (Optional)
LEECH_CAPTION=

# Maximum number of concurrent tasks displayed on each /status page
STATUS_LIMIT=10

# Interval in seconds between periodic status dashboard updates
STATUS_UPDATE_INTERVAL=10

# ==============================================================================
# 5. FILE TRANSFER & STORAGE
# ==============================================================================
# Local directory path where temporary download files are processed (alias: TEMP_DIR)
DOWNLOAD_DIR=downloads

# Default destination for /mirror tasks: tg (Telegram), rc (Rclone), pixeldrain, gofile
DEFAULT_UPLOAD=tg

# Maximum total concurrent tasks across both downloads and uploads (0 for unlimited)
QUEUE_ALL=10

# Maximum concurrent download tasks (alias: MAX_CONCURRENT_DOWNLOADS, 0 for unlimited)
QUEUE_DOWNLOAD=5

# Maximum concurrent upload tasks (alias: MAX_CONCURRENT_UPLOADS, 0 for unlimited)
QUEUE_UPLOAD=5

# Maximum allowed torrent size in bytes (0 for unlimited)
TORRENT_LIMIT=0

# Maximum allowed direct download size in bytes (0 for unlimited)
DIRECT_LIMIT=0

# Maximum allowed local disk usage threshold in bytes (0 for unlimited)
STORAGE_LIMIT=0

# ==============================================================================
# 6. OPTIONAL INTEGRATIONS & EXTERNAL SERVICES
# ==============================================================================
# Port for the built-in HTTP Web Dashboard and direct streaming engine
WEB_PORT=8080

# Web dashboard authentication access password (leave empty to disable password requirement)
WEB_ACCESS_PASSWORD=

# Default Rclone remote name and path for cloud backups (e.g. gdrive:backup)
RCLONE_PATH=remote:backup

# Custom CLI flags passed to rclone binary
RCLONE_FLAGS=--transfers=4 --checkers=8

# Optional HTTP URL serving rclone directory index
RCLONE_SERVE_URL=

# Interval in seconds between background RSS feed checks
RSS_DELAY=600

# ==============================================================================
# 7. ADVANCED SETTINGS & FEATURE TOGGLES
# ==============================================================================
# Enable detailed diagnostic and debug logs
DEBUG=false

# Master kill-switch to disable all /leech operations
DISABLE_LEECH=false

# Master kill-switch to disable all /mirror operations
DISABLE_MIRROR=false

# Master kill-switch to disable BitTorrent / Magnet engine
DISABLE_TORRENTS=false

# Master kill-switch to disable background RSS monitor
DISABLE_RSS=false

# Master kill-switch to disable torrent search engine
DISABLE_SEARCH=false
